rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to validate incoming basic string fields
    function validSubmission(data) {
      return data.keys().hasAll(['email', 'name'])
        && data.email is string
        && data.email.size() > 5
        && data.name is string;
    }

    // Public Read Collections
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /news_events/{newsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media_gallery/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public Form Submissions with Data Validation
    match /donations/{donationId} {
      allow create: if validSubmission(request.resource.data)
                   && request.resource.data.amount is number;
      allow read, update, delete: if request.auth != null;
    }

    match /volunteers/{volunteerId} {
      allow create: if validSubmission(request.resource.data);
      allow read, update, delete: if request.auth != null;
    }

    match /contact_messages/{messageId} {
      allow create: if validSubmission(request.resource.data)
                   && request.resource.data.message is string
                   && request.resource.data.message.size() < 2000;
      allow read, update, delete: if request.auth != null;
    }

    // Admin & Authenticated Collections
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false; // Immutable audit logs
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }
  }
}